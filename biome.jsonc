{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "viewer/**/*.js",
      "e2e/**/*.js",
      "!**/vendor",
      "!**/node_modules",
      "!**/test-results"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "domains": {
      "astro": "none",
      "drizzle": "none",
      "next": "none",
      "qwik": "none",
      "react": "none",
      "reactNative": "none",
      "solid": "none",
      "svelte": "none",
      "tailwind": "none",
      "turborepo": "none",
      "vue": "none",
      "playwright": "all",
      "project": "all",
      "test": "all",
      "types": "all"
    },
    "rules": {
      "a11y": "error",
      "complexity": "error",
      "correctness": "error",
      "performance": "error",
      "security": "error",
      "style": "error",
      "suspicious": "error"
    }
  },
  "overrides": [
    {
      "includes": ["**"],
      "linter": {
        "rules": {
          "style": {
            "noTernary": "off",
            "noCommonJs": "off",
            // A three.js CAD viewer is built from literal coordinates, colours,
            // sizes and tolerances, so naming each one would not make it
            // clearer. Daniel's call, 2026-10-23.
            "noMagicNumbers": "off",
            // main.js is one file because the viewer is classic scripts with no
            // module system; splitting it is a design change, not a lint fix.
            // Daniel's call, 2026-10-23.
            "noExcessiveLinesPerFile": "off",
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  // Object keys are the engine's wire format (rollback_index,
                  // feature_id), and some methods are named after wire ops.
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "formats": ["camelCase", "snake_case"]
                  },
                  {
                    "selector": { "kind": "objectLiteralMethod" },
                    "formats": ["camelCase", "snake_case"]
                  },
                  // CONSTANT_CASE for a file's constants. Biome has no scope
                  // for "top level of the IIFE" each viewer file is wrapped in,
                  // so it is allowed for every const. Daniel's call, 2026-10-23.
                  {
                    "selector": { "kind": "const" },
                    "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
                  }
                ]
              }
            }
          },
          "correctness": {
            "useQwikValidLexicalScope": "off"
          }
        }
      }
    },
    {
      "includes": ["viewer/test/**", "e2e/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off"
          },
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    }
  ]
}
